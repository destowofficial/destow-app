{
  "name": "destow-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Destow backend and mobile applications",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.9",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "start": "turbo start"
  },
  "devDependencies": {
