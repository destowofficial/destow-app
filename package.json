{
  "name": "destow-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Destow backend and mobile applications",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.9",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "start": "turbo start"
  },
  "devDependencies": {
    "turbo": "^2.10.5"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1",
    "react-native-screens": "4.25.2",
    "expo-constants": "57.0.3",
    "expo-linking": "57.0.2"
  }
}
