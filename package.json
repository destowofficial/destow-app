  },
  "overrides": {
    "esbuild": "^0.25.0",
    "postcss": "^8.5.18",
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.9",
    "js-yaml": "^4.3.1",
    "sharp": "^0.35.3",
    "react-native-screens": "~4.26.0",
    "expo-constants": "~57.0.9",
    "expo-linking": "~57.0.5"
  }
}
