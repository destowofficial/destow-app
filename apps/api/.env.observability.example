# Optional overrides for docker-compose.observability.yml.
# Copy the values you need into apps/api/.env for local, or your VPS Compose env.

# Local default. For VPS, set this to ./observability/prometheus.vps.yml.
PROMETHEUS_CONFIG=./observability/prometheus.local.yml
PROMETHEUS_RETENTION=15d
PROMETHEUS_PORT=9090

# Grafana binds to 127.0.0.1 by default in the Compose file.
# Local: http://localhost:3001
# VPS:  ssh -L 3001:localhost:3001 user@server
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=destow_admin_change_me

# Local exporter defaults match apps/api/docker-compose.yml.
# VPS should override the password in the Postgres URL.
POSTGRES_EXPORTER_DATA_SOURCE_NAME=postgresql://destow:destow_local@db:5432/destow?sslmode=disable
REDIS_EXPORTER_ADDR=redis://redis:6379
