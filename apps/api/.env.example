# Environment Variables for Destow Backend
# Copy this file to .env and fill in the values

# ─── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (local PostgreSQL) ──────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:Saikumar@123@localhost:5432/destow_db


# ─── JWT ───────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ─── Firebase Admin SDK ────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Service Accounts
# → Generate New Private Key → download the JSON file
# Then copy the values below from the JSON file:
FIREBASE_PROJECT_ID=destow-696df
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@destow-696df.iam.gserviceaccount.com
