# Environment variables for the Destow API.
# Copy to .env (git-ignored) and fill in. Bun auto-loads .env.
# NEVER commit real secrets or private keys — only placeholders/hints belong here.

# --- Server ----------------------------------------------------------------
NODE_ENV=development              # development | production | test
PORT=3000

# --- Database (Postgres) ---------------------------------------------------
DATABASE_URL=postgres://destow:destow_local@localhost:5434/destow
# SSL for the pg pool: disable | require | no-verify.
# Unset -> prod defaults to no-verify, dev to disable. For verified TLS in prod
# use `require` + NODE_EXTRA_CA_CERTS (RDS CA bundle).
# DATABASE_SSL=require

# --- Redis (revocation denylist + rate limiting) ---------------------------
REDIS_URL=redis://localhost:6379

# --- OTP HMAC secret (hashes OTP codes at rest; NOT the token signing key) --
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_to_a_random_string_at_least_32_chars

# --- Access-token signing (EdDSA / Ed25519) --------------------------------
# Leave UNSET in dev -> the server generates an EPHEMERAL keypair on boot
# (tokens invalidate on every restart). REQUIRED in production (env.ts enforces).
# Generate a keypair:
#   openssl genpkey -algorithm ed25519 -out ed25519.pem
#   openssl pkey -in ed25519.pem -pubout -out ed25519.pub.pem
# Paste the PEMs below, or base64 them for single-line env (normalizePem accepts
# both): `base64 < ed25519.pem` and `base64 < ed25519.pub.pem`.
# JWT_PRIVATE_KEY=<pem-or-base64-of-private-key>
# JWT_PUBLIC_KEY=<pem-or-base64-of-public-key>
# JWT_KID=dev
# JWT_ISSUER=destow
# JWT_AUDIENCE=destow-app
# ACCESS_TOKEN_TTL_SEC=600         # 10 min
# REFRESH_TOKEN_TTL_DAYS=60

# --- OTP rate limits -------------------------------------------------------
# OTP_RESEND_COOLDOWN_SEC=60
# OTP_MAX_PER_HOUR=5

# --- AWS (SNS sends OTP SMS in prod) ---------------------------------------
AWS_REGION=ap-south-1

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=*                   # '*' or comma-separated origins

# --- Optional integrations (validated only when set) -----------------------
# MAPS_API_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
