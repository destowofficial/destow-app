{
  "name": "@destow/api",
  "version": "1.0.0",
  "description": "Destow backend — Bun + Express + Drizzle/Postgres",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "lint": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@destow/contracts": "*",
    "@aws-sdk/client-sns": "^3.1045.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.40.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.20.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.6",
    "typescript": "^5.8.3"
  }
}
