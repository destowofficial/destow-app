{
  "expo": {
    "name": "Destow",
    "slug": "destow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "destow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.destow.app",
      "config": {
        "googleMapsApiKey": "$EXPO_PUBLIC_IOS_MAPS_KEY"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#ffffff",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.destow.app",
      "config": {
        "googleMaps": {
          "apiKey": "$EXPO_PUBLIC_ANDROID_MAPS_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Destow uses your location to set your pickup point so the driver knows where to collect you.",
          "locationWhenInUsePermission": "Destow uses your location to set your pickup point so the driver knows where to collect you.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
