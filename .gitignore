# Dependencies
node_modules/
.npm/

# npm lockfiles — this is a Bun workspace, bun.lock is the single source of truth
package-lock.json
**/package-lock.json

# Environment variables
.env
.env.local
.env.*.local

# Build outputs
dist/
build/
.expo/
.next/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
.DS_Store
Thumbs.db

# Deployment packages
*.zip
packaged.yaml

# Turborepo cache
.turbo/

# Database backups (local dumps)
backups/

# Docker Compose local dev overrides (hot-reload etc.) — never committed
docker-compose.override.yml
**/docker-compose.override.yml

# Claude Code (local, not shared)
.claude/

# Documentation — local only (incl. superpowers specs/plans), except these two
docs/*
!docs/ARCHITECTURE.md
!docs/TARGETS.md

# City photographs for the mobile app: ~2MB of regenerable Wikimedia Commons
# files. Fetch them with 'make city-photos'; the app falls back to pin tiles
# without them. credits.json IS committed - the licences require attribution.
apps/mobile/assets/cities/*.jpg
